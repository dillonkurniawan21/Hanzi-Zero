{
  "version": 2,
  "builds": [
    {
      "src": "hsk-learning-app/api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "hsk-learning-app/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "hsk-learning-app/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "hsk-learning-app/$1"
    }
  ]
}
