{
  "builds": [
    {
      "src": "hsk-learning-app/api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "hsk-learning-app/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "hsk-learning-app/api/index.py"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|h5))",
      "dest": "hsk-learning-app/$1"
    },
    {
      "src": "/(.*)",
      "dest": "hsk-learning-app/index.html"
    }
  ]
}
